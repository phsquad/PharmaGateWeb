{
  "short_name": "PharmaGate",
  "name": "PharmaGate EDI Pro 2026 — Web PWA Studio",
  "description": "Автономный фармацевтический EDI/DBF шлюз, валидатор ФЛК и генератор УПД 970@",
  "icons": [
    {
      "src": "icons/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "./index.html",
  "background_color": "#0f172a",
  "theme_color": "#030712",
  "display": "standalone",
  "orientation": "any",
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Фармацевтическая накладная",
      "accept": {
        "application/x-dbf": [".dbf"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "application/xml": [".xml"],
        "text/xml": [".xml"],
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [".dbf", ".xlsx", ".xls", ".xml", ".csv"]
        }
      ]
    }
  }
}
